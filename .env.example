# UnaMonedita: variables de entorno.
#
# La app NO tiene contraseña: conectar Notion (token + URL de tu página, en /setup)
# es el ingreso. Esa conexión vive en una cookie cifrada de cada dispositivo, y cada
# persona usa su propia cuenta de Notion. Por eso el único valor obligatorio es el
# secreto con el que se cifran esas cookies.

# ─── OBLIGATORIO ─────────────────────────────────────────────────────────────
# Secreto para cifrar la cookie de conexión (mínimo 32 caracteres).
# Generar uno propio con:  openssl rand -base64 32
# Si cambia, todos los dispositivos pierden la conexión y hay que reconectar.
AUTH_COOKIE_SECRET=cambiame_por_32_chars_random_xxxxxxxxxxxxxxxxxxxxxxx

# ─── SOLO DESARROLLO LOCAL (localhost) ───────────────────────────────────────
# Con DEV_AUTH_BYPASS=1 y `next dev`, la app entra sin pasar por /setup y usa las
# credenciales de Notion de estas variables. Solo funciona abriendo la app por
# localhost / 127.0.0.1 / [::1]; desde otra IP o dominio no hace nada.
# NUNCA definir esto (ni NOTION_*) en Vercel ni en ningún entorno desplegado.
# DEV_AUTH_BYPASS=1
# NOTION_TOKEN=
# NOTION_DB_TRANSACTIONS=
# NOTION_DB_ACCOUNTS=
# NOTION_DB_CATEGORIES=
# NOTION_DB_SUBSCRIPTIONS=
# NOTION_DB_BUDGETS=
# NOTION_DB_FX_RATES=

# ─── SOLO PARA scripts/publish-notion-guide.ts (CLI) ─────────────────────────
# NOTION_PARENT_PAGE_ID=
